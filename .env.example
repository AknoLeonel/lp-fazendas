# ID do Google Tag Manager (ex.: GTM-ABC1234)
NEXT_PUBLIC_GTM_ID=
# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.realizaagro.com.br
# Webhook que recebe os leads do formulário (CRM, Make, Zapier, RD Station...)
LEAD_WEBHOOK_URL=

# Painel de cadastro de fazendas (/admin)
ADMIN_PASSWORD=
# Opcional: segredo para assinar a sessão do painel (se vazio, usa ADMIN_PASSWORD)
ADMIN_SECRET=
# Criado ao conectar um Blob store PÚBLICO ao projeto na Vercel (Storage)
BLOB_READ_WRITE_TOKEN=
